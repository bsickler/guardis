{
  "name": "@spudlabs/guardis",
  "version": "0.8.0",
  "license": "MIT",
  "description": "Guardis is a modular library of type guards, built to be easy to use and extend.",
  "exports": {
    ".": "./mod.ts",
    "./async": "./src/modules/async.ts",
    "./http": "./src/modules/http.ts",
    "./http-branded": "./src/modules/http.branded.ts",
    "./node-streams": "./src/modules/node-streams.ts",
    "./streams": "./src/modules/streams.ts",
    "./strings": "./src/modules/strings.ts",
    "./strings-branded": "./src/modules/strings.branded.ts"
  },
  "tasks": {
    "test": {
      "description": "Run unit tests.",
      "command": "deno test"
    },
    "bench:competitors": {
      "description": "Run comparative benchmarks against Zod, ArkType, and Valibot.",
      "command": "deno bench --config ../benchmarks/deno.json ../benchmarks/"
    },
    "bench:primitives": {
      "description": "Benchmark primitive type guards.",
      "command": "deno bench benchmarks/guard.bench.ts benchmarks/guard.json.bench.ts benchmarks/guard.jsonArray.bench.ts"
    },
    "bench:parser-vs-shape": {
      "description": "Benchmark parser vs shape object validation across complexity levels.",
      "command": "deno bench benchmarks/parser-vs-shape.bench.ts"
    },
    "build:npm": {
      "description": "Build npm package using dnt.",
      "command": "deno run -A scripts/build_npm.ts"
    }
  },
  "publish": {
    "include": ["mod.ts", "README.md", "deno.json", "src/", "specs/"],
    "exclude": ["**/*.test.ts", "**/*.bench.ts", "benchmarks/"]
  },
  "compilerOptions": {},
  "fmt": {
    "lineWidth": 100
  }
}
